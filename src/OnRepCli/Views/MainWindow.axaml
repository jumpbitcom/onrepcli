<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OnRepCli.ViewModels"
        xmlns:models="using:OnRepCli.Models"
        xmlns:resources="using:OnRepCli.Resources"
        x:Class="OnRepCli.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static resources:Strings.AppTitle}"
        Width="1180"
        Height="820"
        MinWidth="760"
        MinHeight="560"
        Background="{DynamicResource PageBrush}">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource ForestBrush}"
                Padding="36,26">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="{x:Static resources:Strings.BrandTitle}"
                               Foreground="{DynamicResource CloudBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBlock Text="{x:Static resources:Strings.BrandSubtitle}"
                               Foreground="{DynamicResource CloudBrush}"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource CloudMutedBrush}"
                               FontSize="14"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Classes="refresh"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static resources:Strings.RefreshAccessibleName}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="250,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    Padding="22,28">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Static resources:Strings.Rubrics}"
                               FontSize="12"
                               FontWeight="Bold"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             Background="Transparent"
                             BorderThickness="0"
                             AutomationProperties.Name="{x:Static resources:Strings.SectionsAccessibleName}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NewsSection">
                                <TextBlock Text="{Binding Name}"
                                           Padding="12,10"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{x:Static resources:Strings.IndependentNews}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Padding="38,34"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.Latest}"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForestBrush}" />
                        <TextBlock Text="{x:Static resources:Strings.LatestDescription}"
                                   Classes="muted"
                                   FontSize="16" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Articles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NewsArticle">
                                <Border Classes="article-card" Margin="0,0,0,16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Border Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Section}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForestBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayDate}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="15"
                                                   LineHeight="23"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
