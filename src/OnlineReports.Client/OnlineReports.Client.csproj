<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\assets\jumpbit-theme.axaml" Link="Assets\jumpbit-theme.axaml" />
    <AvaloniaResource Include="..\..\assets\jumpbit-styles.axaml" Link="Assets\jumpbit-styles.axaml" />
    <AvaloniaResource Include="..\..\assets\font\Inter-VariableFont_opsz,wght.ttf" Link="Assets\Fonts\Inter-VariableFont_opsz,wght.ttf" />
    <AvaloniaResource Include="..\..\assets\font\Inter-Italic-VariableFont_opsz,wght.ttf" Link="Assets\Fonts\Inter-Italic-VariableFont_opsz,wght.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
