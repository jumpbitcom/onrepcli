<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Include after FluentTheme and jumpbit-theme.axaml in App.axaml:
       <StyleInclude Source="avares://YourApp/Assets/jumpbit-styles.axaml" /> -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource JbBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource JbBodyFont}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource JbBodyFont}" />
    <Setter Property="FontSize" Value="42" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource JbBodyFont}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontFamily" Value="{StaticResource JbBodyFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h4">
    <Setter Property="FontFamily" Value="{StaticResource JbBodyFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource JbTextMutedBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource JbPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbOnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource JbRadiusMd}" />
    <Setter Property="FontFamily" Value="{StaticResource JbBodyFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="20,10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbPrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbPrimaryHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource JbOnPrimaryBrush}" />
  </Style>

  <Style Selector="Button.info">
    <Setter Property="Background" Value="{DynamicResource JbSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.language-picker">
    <Setter Property="Background" Value="{DynamicResource JbSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource JbRadiusMd}" />
    <Setter Property="Padding" Value="4,2" />
  </Style>

  <!-- Section menu: the ListBoxItem itself is the single rounded box; no nested borders. -->
  <Style Selector="ListBox.sections ListBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource JbRadiusMd}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource JbRadiusMd}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource JbTextBrush}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbTextBrush}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbTextBrush}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbOnPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbOnPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbOnPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource JbPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JbOnPrimaryBrush}" />
  </Style>

  <!-- Article list: the card is the only box; the ListBoxItem stays invisible and the card border highlights. -->
  <Style Selector="ListBox.articles ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.articles ListBoxItem:pointerover Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource JbPrimaryBrush}" />
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource JbInfoBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource JbSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JbBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource JbRadiusLg}" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style Selector="Border.landing">
    <Setter Property="Background" Value="{StaticResource JbBrandGradientBrush}" />
  </Style>
</Styles>
